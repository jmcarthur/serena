cabal-version:      2.4
name:               test-repo
version:            0.1.0.0
synopsis:           Test repository for Haskell language server testing
description:        Test repository for Haskell language server testing
license:            BSD-3-Clause
author:             Test Author
maintainer:         test@example.com
copyright:          2025 Test Author
category:           Testing
build-type:         Simple
extra-source-files: README.md

library
  exposed-modules:     Lib
  hs-source-dirs:      src
  build-depends:       base >=4.7 && <5
  default-language:    Haskell2010

executable test-repo-exe
  main-is:             Main.hs
  other-modules:       Paths_test_repo
  hs-source-dirs:      app
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  build-depends:       
      base >=4.7 && <5
    , test-repo
  default-language:    Haskell2010